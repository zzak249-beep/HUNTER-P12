# ═══ P12 HUNTER · PLANTILLA RAILWAY (DINERO REAL) ═══
# Railway → servicio → Variables → "Raw Editor" → pega todo esto y rellena las 4 claves.

# ── Obligatorias ──
DRY_RUN=false
BINGX_DEMO=false
BINGX_API_KEY=PON_AQUI_TU_API_KEY
BINGX_API_SECRET=PON_AQUI_TU_API_SECRET
TELEGRAM_TOKEN=PON_AQUI_EL_TOKEN_DE_BOTFATHER
TELEGRAM_CHAT_ID=PON_AQUI_TU_CHAT_ID
STATE_PATH=/data/state.json

# ── Monedas ──
# SYMBOLS: ALL (todas las perpetuas USDT que cumplan los filtros) | TOP:30 | BTC/USDT:USDT,ETH/USDT:USDT
SYMBOLS=TOP:30
MIN_VOLUME_USDT=10000000
MAX_SYMBOLS=150
EXCLUDE=
# Límites globales (todas las monedas comparten estos topes)
MAX_OPEN_POSITIONS=3
MAX_TOTAL_RISK_PCT=1.0

# ── Mercado y riesgo ──
SYMBOL=BTC/USDT:USDT
LEVERAGE=10
RISK_PCT=0.25
EQUITY_OVERRIDE=0
PAPER_EQUITY=1000
TZ_LOCAL=Europe/Madrid
WARMUP_DAYS=25
MAX_DD_R=8

# ── Horario (HHMM, hora Nueva York) ──
P12_START=1800
LONDON_START=230
P12_END=600
READ_END=900
OPEN=930
LAST_ENTRY=1200
FORCE_EXIT=1555
SKIP_WEEKENDS=true

# ── Aceptación ──
ACCEPT_MODE=mp
MP_N=2
MP_M=3
ACCEPT_MIN=30
RVOL_MIN=0

# ── Filtros (todos apagados, como el Pine) ──
NIGHT_FILTER=none
COINC_MODE=mid
MISMATCH=reduce
REDUCE_F=0.5
MO_FILTER=off
W_LOOK=20
W_NARROW=0.75
W_WIDE=1.33
WIDTH_FILTER=off
EVENT_FILTER=off
EVENT_DATES=
RVOL_READ_FILTER=off
RVOL_READ_MIN=0.8
DAILY_MOM=off
VOL_FILTER=off
VOL_NARROW=0.70
VOL_WIDE=1.50

# ── Entrada y salida ──
ATR_LEN=14
STOP_BUF=0.25
TGT_MODE=fixed_r
RR=2.0
EXT_K=1.0
BE_R=0
PARTIAL_R=1.0
PARTIAL_PCT=50
TRAIL_ACT_R=1.5
TRAIL_MODE=atr
TRAIL_ATR=1.0
TRAIL_R=0.8
MAX_HOURS=6

# ── Racha de pérdidas ──
LOSS_STREAK_N=3
LOSS_ACTION=reduce
LOSS_REDUCE=0.5

# ── Costes ──
COST_RT=0.12
STOP_SLIP=0.05
ENTRY_SLIP=0.02
MAX_COST_R=0.20
MAX_STOP_PCT=2.5
FUND_H=8
FUND_PCT=0.01
