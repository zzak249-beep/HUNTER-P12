# ── Empieza SIEMPRE en DRY_RUN=true (solo señales + paper trading) ──
DRY_RUN=true
BINGX_DEMO=false
BINGX_API_KEY=
BINGX_API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
SYMBOL=BTC/USDT:USDT
LEVERAGE=10
RISK_PCT=0.5
TZ_LOCAL=Europe/Madrid
# Railway: crea un Volume montado en /data
STATE_PATH=/data/state.json
MAX_DD_R=8
# ── Variables NUEVAS del scanner (añádelas en Railway; el resto de tus variables P12 siguen valiendo) ──
# No necesita BINGX_API_KEY/SECRET: solo lee velas públicas.
SYMBOLS=ALL
MIN_VOLUME_USDT=10000000
SCAN_RATE=8            # peticiones/seg globales a BingX (sube a 12 si no ves errores 429)
SCAN_WORKERS=12        # hilos en paralelo
MAX_SIGNALS_DAY=6      # tope de avisos por día (evita inundarte cuando todas las alts se mueven juntas)
ACCOUNT_EQUITY=1000    # tu saldo real, para calcular el tamaño sugerido en cada aviso
RISK_PCT=0.5
LEVERAGE=10
SCANNER_STATE=/data/scanner_state.json
